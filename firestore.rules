rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Main-gate timing fields on users/{uid}/devices/{deviceDocId}:
    // openDurationMs/closeDurationMs are integer milliseconds (5000..60000).
    // timingUpdatedAt is a server timestamp written only with a timing change.
    // Sub-gate calibration fields on the same device documents:
    // servoOpenAngle/servoCloseAngle are distinct integer degrees (0..180).
    // servoConfigUpdatedAt is written only with a protected calibration change.

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRecentAuthentication() {
      return isAuthenticated() &&
        request.auth.token.auth_time is int &&
        request.auth.token.auth_time >= (request.time.toMillis() / 1000) - 300;
    }

    function isValidOwnerDeviceUpdate(userId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let changesTiming = affected.hasAny([
        'openDurationMs',
        'closeDurationMs',
        'timingUpdatedAt'
      ]);
      let changesServoConfig = affected.hasAny([
        'servoOpenAngle',
        'servoCloseAngle',
        'servoConfigUpdatedAt'
      ]);
      return isOwner(userId) &&
        ((!changesTiming && !changesServoConfig) ||
          (changesTiming && !changesServoConfig &&
            affected.hasOnly([
              'openDurationMs',
              'closeDurationMs',
              'timingUpdatedAt'
            ]) &&
            resource.data.type == 'actuator' &&
            request.resource.data.type == 'actuator' &&
            resource.data.deviceId.matches('^DILIG-MAIN-[A-F0-9]{12}$') &&
            request.resource.data.deviceId == resource.data.deviceId &&
            request.resource.data.openDurationMs is int &&
            request.resource.data.openDurationMs >= 5000 &&
            request.resource.data.openDurationMs <= 60000 &&
            request.resource.data.closeDurationMs is int &&
            request.resource.data.closeDurationMs >= 5000 &&
            request.resource.data.closeDurationMs <= 60000 &&
            request.resource.data.timingUpdatedAt == request.time &&
            hasRecentAuthentication()) ||
          (!changesTiming && changesServoConfig &&
            affected.hasOnly([
              'servoOpenAngle',
              'servoCloseAngle',
              'servoConfigUpdatedAt'
            ]) &&
            resource.data.type == 'actuator' &&
            request.resource.data.type == 'actuator' &&
            resource.data.deviceId.matches('^DILIG-SUB-[A-F0-9]{12}$') &&
            request.resource.data.deviceId == resource.data.deviceId &&
            request.resource.data.servoOpenAngle is int &&
            request.resource.data.servoOpenAngle >= 0 &&
            request.resource.data.servoOpenAngle <= 180 &&
            request.resource.data.servoCloseAngle is int &&
            request.resource.data.servoCloseAngle >= 0 &&
            request.resource.data.servoCloseAngle <= 180 &&
            request.resource.data.servoOpenAngle != request.resource.data.servoCloseAngle &&
            request.resource.data.servoConfigUpdatedAt == request.time &&
            hasRecentAuthentication()));
    }

    function isValidOwnerDeviceCreate(userId) {
      return isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'openDurationMs',
          'closeDurationMs',
          'timingUpdatedAt',
          'servoOpenAngle',
          'servoCloseAngle',
          'servoConfigUpdatedAt'
        ]);
    }

    function isValidMoisture(val) {
      return val is number && val >= 0 && val <= 100;
    }

    function isValidTemperature(val) {
      return val is number && val >= -40 && val <= 85;
    }

    function hasEnabledAutomationConfig(data) {
      return data.keys().hasAny(['automationConfig']) &&
        data.automationConfig is map &&
        data.automationConfig.keys().hasAny(['enabled']) &&
        data.automationConfig.enabled == true;
    }

    function isAutomaticControl(data) {
      let hasMode = data.keys().hasAny(['controlMode']);
      return (hasMode && data.controlMode == 'automatic') ||
        (!hasMode && hasEnabledAutomationConfig(data));
    }

    function isManualControl(data) {
      let hasMode = data.keys().hasAny(['controlMode']);
      return (hasMode && data.controlMode == 'manual') ||
        (!hasMode && !hasEnabledAutomationConfig(data));
    }

    function registryMatchesSensor(userId, deviceDocId, hardwareId) {
      let registry = get(/databases/$(database)/documents/deviceRegistry/$(hardwareId));
      return registry.data.userId == userId &&
        registry.data.deviceDocId == deviceDocId &&
        registry.data.deviceId == hardwareId &&
        registry.data.type == 'sensor';
    }

    function registryMatchesSensorUser(userId, hardwareId) {
      let registry = get(/databases/$(database)/documents/deviceRegistry/$(hardwareId));
      return registry.data.userId == userId &&
        registry.data.deviceId == hardwareId &&
        registry.data.type == 'sensor';
    }

    function registryMatchesActuator(userId, deviceDocId, hardwareId) {
      let registry = get(/databases/$(database)/documents/deviceRegistry/$(hardwareId));
      return registry.data.userId == userId &&
        registry.data.deviceDocId == deviceDocId &&
        registry.data.deviceId == hardwareId &&
        registry.data.type == 'actuator';
    }

    function registryMatchesActuatorUser(userId, hardwareId) {
      let registry = get(/databases/$(database)/documents/deviceRegistry/$(hardwareId));
      return registry.data.userId == userId &&
        registry.data.deviceId == hardwareId &&
        registry.data.type == 'actuator';
    }

    function isValidTelemetryReading(data, hardwareId) {
      return data.keys().hasOnly([
          'deviceId',
          'soilTemperatureC',
          'soilMoisturePercent',
          'recordedAt'
        ]) &&
        data.deviceId == hardwareId &&
        // A failed DS18B20 must not prevent a valid moisture probe from
        // reporting. Firmware represents the unavailable probe as null.
        (data.soilTemperatureC == null || isValidTemperature(data.soilTemperatureC)) &&
        isValidMoisture(data.soilMoisturePercent) &&
        data.recordedAt is number;
    }

    function isRegisteredSensorDeviceUpdate(userId, deviceDocId) {
      return request.auth == null &&
        resource.data.type == 'sensor' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'lastSeenAt',
          'latestReading',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'online' &&
        request.resource.data.lastSeenAt is number &&
        request.resource.data.updatedAt == request.resource.data.lastSeenAt &&
        request.resource.data.latestReading is map &&
        isValidTelemetryReading(request.resource.data.latestReading, resource.data.deviceId) &&
        request.resource.data.latestReading.recordedAt == request.resource.data.lastSeenAt &&
        registryMatchesSensor(userId, deviceDocId, resource.data.deviceId);
    }

    function isRegisteredSensorDeviceRead(userId, deviceDocId) {
      return request.auth == null &&
        resource.data.type == 'sensor' &&
        registryMatchesSensor(userId, deviceDocId, resource.data.deviceId);
    }

    function isRegisteredSensorReadingWrite(userId, deviceDocId, readingId) {
      let device = get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceDocId));
      return request.auth == null &&
        readingId == 'latest' &&
        device.data.type == 'sensor' &&
        isValidTelemetryReading(request.resource.data, device.data.deviceId) &&
        registryMatchesSensor(userId, deviceDocId, device.data.deviceId);
    }

    function isRegisteredActuatorDeviceRead(userId, deviceDocId) {
      return request.auth == null &&
        resource.data.type == 'actuator' &&
        registryMatchesActuator(userId, deviceDocId, resource.data.deviceId);
    }

    function isRegisteredActuatorHeartbeat(userId, deviceDocId) {
      return request.auth == null &&
        resource.data.type == 'actuator' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'lastSeenAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'online' &&
        request.resource.data.lastSeenAt is number &&
        request.resource.data.updatedAt == request.resource.data.lastSeenAt &&
        registryMatchesActuator(userId, deviceDocId, resource.data.deviceId);
    }

    function isRegisteredActuatorGateRead(userId) {
      return request.auth == null &&
        resource.data.actuatorDeviceId is string &&
        registryMatchesActuatorUser(userId, resource.data.actuatorDeviceId);
    }

    function isRegisteredActuatorPositionUpdate(userId) {
      return request.auth == null &&
        resource.data.actuatorDeviceId is string &&
        resource.data.pendingCommandId == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reportedState',
          'updatedAt'
        ]) &&
        request.resource.data.reportedState in ['open', 'closed', 'error'] &&
        request.resource.data.updatedAt is number &&
        registryMatchesActuatorUser(userId, resource.data.actuatorDeviceId);
    }

    function isRegisteredActuatorCompletion(userId, gateId) {
      let command = getAfter(/databases/$(database)/documents/users/$(userId)/gates/$(gateId)/commands/$(resource.data.pendingCommandId));
      return request.auth == null &&
        resource.data.actuatorDeviceId is string &&
        resource.data.pendingCommandId is string &&
        resource.data.reportedState == 'moving' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reportedState',
          'pendingCommandId',
          'activeCommandSource',
          'updatedAt'
        ]) &&
        request.resource.data.pendingCommandId == null &&
        request.resource.data.activeCommandSource == null &&
        request.resource.data.updatedAt is number &&
        command.data.gateId == gateId &&
        command.data.actuatorDeviceId == resource.data.actuatorDeviceId &&
        command.data.completedAt == request.resource.data.updatedAt &&
        ((command.data.status == 'succeeded' &&
          ((command.data.command == 'OPEN' && request.resource.data.reportedState == 'open') ||
           (command.data.command == 'CLOSE' && request.resource.data.reportedState == 'closed'))) ||
         (command.data.status == 'failed' && request.resource.data.reportedState == 'error')) &&
        registryMatchesActuatorUser(userId, resource.data.actuatorDeviceId);
    }

    function isValidAutomationConfig(data, sensorDeviceId) {
      return data is map &&
        data.keys().hasOnly([
          'enabled',
          'sensorDeviceId',
          'temperatureThresholdC',
          'moistureThresholdPercent',
          'temperatureHysteresisC',
          'moistureHysteresisPercent',
          'updatedAt'
        ]) &&
        data.enabled == true &&
        data.sensorDeviceId == sensorDeviceId &&
        isValidTemperature(data.temperatureThresholdC) &&
        isValidMoisture(data.moistureThresholdPercent) &&
        data.temperatureHysteresisC == 2 &&
        data.moistureHysteresisPercent == 5 &&
        data.updatedAt is number;
    }

    function isRegisteredSensorAutomationReading(userId) {
      return request.auth == null &&
        isAutomaticControl(resource.data) &&
        resource.data.sensorDeviceId is string &&
        isValidAutomationConfig(resource.data.automationConfig, resource.data.sensorDeviceId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['automationReading']) &&
        request.resource.data.automationReading is map &&
        isValidTelemetryReading(request.resource.data.automationReading, resource.data.sensorDeviceId) &&
        registryMatchesSensorUser(userId, resource.data.sensorDeviceId);
    }

    function isAutomaticDirectionValid(gate, command) {
      let config = gate.automationConfig;
      let reading = gate.automationReading;
      return isAutomaticControl(gate) &&
        isValidAutomationConfig(config, gate.sensorDeviceId) &&
        reading is map &&
        isValidTelemetryReading(reading, gate.sensorDeviceId) &&
        reading.soilTemperatureC != null &&
        reading.recordedAt >= request.time.toMillis() - 90000 &&
        reading.recordedAt <= request.time.toMillis() + 30000 &&
        command.triggerReadingAt == reading.recordedAt &&
        ((command.command == 'CLOSE' &&
          (reading.soilTemperatureC < config.temperatureThresholdC ||
           reading.soilMoisturePercent < config.moistureThresholdPercent)) ||
         (command.command == 'OPEN' &&
          reading.soilTemperatureC >= config.temperatureThresholdC + config.temperatureHysteresisC &&
          reading.soilMoisturePercent >= config.moistureThresholdPercent + config.moistureHysteresisPercent));
    }

    function isRegisteredActuatorAutomaticReservation(userId, gateId) {
      let commandId = request.resource.data.pendingCommandId;
      let command = getAfter(/databases/$(database)/documents/users/$(userId)/gates/$(gateId)/commands/$(commandId));
      return request.auth == null &&
        resource.data.actuatorDeviceId is string &&
        resource.data.pendingCommandId == null &&
        resource.data.reportedState != 'moving' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reportedState',
          'pendingCommandId',
          'activeCommandSource',
          'updatedAt'
        ]) &&
        request.resource.data.reportedState == 'moving' &&
        request.resource.data.pendingCommandId is string &&
        request.resource.data.activeCommandSource == 'automatic' &&
        request.resource.data.updatedAt is number &&
        command.data.source == 'automatic' &&
        command.data.actuatorDeviceId == resource.data.actuatorDeviceId &&
        isAutomaticDirectionValid(resource.data, command.data) &&
        registryMatchesActuatorUser(userId, resource.data.actuatorDeviceId);
    }

    function isRegisteredActuatorCommandRead(userId, gateId) {
      let gate = get(/databases/$(database)/documents/users/$(userId)/gates/$(gateId));
      return request.auth == null &&
        gate.data.actuatorDeviceId == resource.data.actuatorDeviceId &&
        registryMatchesActuatorUser(userId, resource.data.actuatorDeviceId);
    }

    function isValidActuatorCommandTransition(userId, gateId, commandId) {
      let gate = get(/databases/$(database)/documents/users/$(userId)/gates/$(gateId));
      let gateAfter = getAfter(/databases/$(database)/documents/users/$(userId)/gates/$(gateId));
      return request.auth == null &&
        gate.data.actuatorDeviceId == resource.data.actuatorDeviceId &&
        resource.data.gateId == gateId &&
        gate.data.pendingCommandId == commandId &&
        gate.data.reportedState == 'moving' &&
        registryMatchesActuatorUser(userId, resource.data.actuatorDeviceId) &&
        ((resource.data.status == 'pending' &&
          request.resource.data.status == 'executing' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
         (resource.data.status == 'executing' &&
          request.resource.data.status in ['succeeded', 'failed'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'completedAt',
            'errorMessage'
          ]) &&
          request.resource.data.completedAt is number &&
          gateAfter.data.pendingCommandId == null &&
          gateAfter.data.updatedAt == request.resource.data.completedAt &&
          ((request.resource.data.status == 'succeeded' &&
            ((resource.data.command == 'OPEN' && gateAfter.data.reportedState == 'open') ||
             (resource.data.command == 'CLOSE' && gateAfter.data.reportedState == 'closed'))) ||
           (request.resource.data.status == 'failed' && gateAfter.data.reportedState == 'error'))));
    }

    function isValidOwnerCommandCreate(userId, gateId, commandId) {
      let gateAfter = getAfter(/databases/$(database)/documents/users/$(userId)/gates/$(gateId));
      return isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'gateId',
          'actuatorDeviceId',
          'command',
          'status',
          'requestedAt',
          'completedAt',
          'errorMessage',
          'source',
          'triggerReadingAt'
        ]) &&
        request.resource.data.gateId == gateId &&
        request.resource.data.actuatorDeviceId == gateAfter.data.actuatorDeviceId &&
        request.resource.data.command in ['OPEN', 'CLOSE'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt is number &&
        request.resource.data.completedAt == null &&
        request.resource.data.errorMessage == null &&
        request.resource.data.source == 'manual' &&
        request.resource.data.triggerReadingAt == null &&
        isManualControl(gateAfter.data) &&
        gateAfter.data.pendingCommandId == commandId &&
        gateAfter.data.reportedState == 'moving' &&
        gateAfter.data.activeCommandSource == 'manual';
    }

    function isValidAutomaticCommandCreate(userId, gateId, commandId) {
      let gate = get(/databases/$(database)/documents/users/$(userId)/gates/$(gateId));
      let gateAfter = getAfter(/databases/$(database)/documents/users/$(userId)/gates/$(gateId));
      return request.auth == null &&
        request.resource.data.keys().hasOnly([
          'gateId',
          'actuatorDeviceId',
          'command',
          'status',
          'requestedAt',
          'completedAt',
          'errorMessage',
          'source',
          'triggerReadingAt'
        ]) &&
        request.resource.data.gateId == gateId &&
        request.resource.data.actuatorDeviceId == gate.data.actuatorDeviceId &&
        request.resource.data.command in ['OPEN', 'CLOSE'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt is number &&
        request.resource.data.completedAt == null &&
        request.resource.data.errorMessage == null &&
        request.resource.data.source == 'automatic' &&
        request.resource.data.triggerReadingAt is number &&
        gate.data.pendingCommandId == null &&
        gate.data.reportedState != 'moving' &&
        isAutomaticControl(gate.data) &&
        gateAfter.data.pendingCommandId == commandId &&
        gateAfter.data.reportedState == 'moving' &&
        gateAfter.data.activeCommandSource == 'automatic' &&
        isAutomaticDirectionValid(gate.data, request.resource.data) &&
        registryMatchesActuatorUser(userId, request.resource.data.actuatorDeviceId);
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Registered Devices subcollection
      match /devices/{deviceDocId} {
        allow get: if isOwner(userId) ||
          isRegisteredActuatorDeviceRead(userId, deviceDocId) ||
          isRegisteredSensorDeviceRead(userId, deviceDocId);
        allow list: if isOwner(userId);
        allow create: if isValidOwnerDeviceCreate(userId);
        allow delete: if isOwner(userId);
        allow update: if isValidOwnerDeviceUpdate(userId) ||
          isRegisteredSensorDeviceUpdate(userId, deviceDocId) ||
          isRegisteredActuatorHeartbeat(userId, deviceDocId);

        // Soil Readings subcollection
        match /readings/{readingId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) ||
            isRegisteredSensorReadingWrite(userId, deviceDocId, readingId);
          allow delete: if isOwner(userId);
        }
      }

      // Irrigation Gates subcollection
      match /gates/{gateId} {
        allow get: if isOwner(userId) || isRegisteredActuatorGateRead(userId);
        allow list: if isOwner(userId);
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId) ||
          isRegisteredActuatorPositionUpdate(userId) ||
          isRegisteredActuatorCompletion(userId, gateId) ||
          isRegisteredSensorAutomationReading(userId) ||
          isRegisteredActuatorAutomaticReservation(userId, gateId);

        // Gate Commands subcollection
        match /commands/{commandId} {
          allow get: if isOwner(userId) || isRegisteredActuatorCommandRead(userId, gateId);
          allow list: if isOwner(userId);
          allow create: if isValidOwnerCommandCreate(userId, gateId, commandId) ||
            isValidAutomaticCommandCreate(userId, gateId, commandId);
          allow update: if isOwner(userId) ||
            isValidActuatorCommandTransition(userId, gateId, commandId);
          allow delete: if isOwner(userId);
        }
      }


      // User-owned visual field quadrants. Hardware never reads or writes
      // this collection; it is presentation metadata for the web app only.
      match /quadrants/{quadrantId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Globally unique hardware IDs route telemetry to the account that registered
    // the device. A registry entry must be created atomically with its user device.
    match /deviceRegistry/{deviceId} {
      // Exact document lookup is public so an unauthenticated ESP32 can resolve
      // its owner dynamically. Collection listing remains forbidden.
      allow get: if true;
      allow list: if false;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.deviceId == deviceId &&
        request.resource.data.type in ['sensor', 'actuator'] &&
        request.resource.data.createdAt is number &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/devices/$(request.resource.data.deviceDocId)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/devices/$(request.resource.data.deviceDocId)).data.deviceId == deviceId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/devices/$(request.resource.data.deviceDocId)).data.type == request.resource.data.type;

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
  }
}
